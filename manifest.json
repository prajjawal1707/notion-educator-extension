{
  "manifest_version": 3,
  "name": "Web Educator",
  "version": "2.0",
  "description": "An interactive guide and chatbot for any website.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"], 
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}